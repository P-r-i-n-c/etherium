{% doc %}
  @prompt
    NECESITO UNA IMAGEN DE UNA FICHE DE AJEDREZ FLOTANDO, QUITALE EL FONDO BLANCO A LA IMAGEN QUE SUBI , QUIERO LA IMEGNE ESTE UN POQUITO MAS PEQUEÑA Y UN POCO MAS PEGADA ENCIMA DEL ENCABEZADO 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-floating-chess-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding }}px;
    background-color: transparent;
    position: relative;
    overflow: hidden;
    margin-top: -{{ block.settings.overlap_distance }}px;
  }

  .ai-floating-chess-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    max-width: {{ block.settings.image_max_width }}px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .ai-floating-chess-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    animation: ai-floating-chess-float-{{ ai_gen_id }} {{ block.settings.animation_duration }}s ease-in-out infinite;
  }

  .ai-floating-chess-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-floating-chess-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 400px;
    max-height: 400px;
  }

  .ai-floating-chess-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @keyframes ai-floating-chess-float-{{ ai_gen_id }} {
    0%, 100% {
      transform: translateY(0px) rotate({{ block.settings.rotation_start }}deg);
    }
    50% {
      transform: translateY(-{{ block.settings.float_distance }}px) rotate({{ block.settings.rotation_end }}deg);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-floating-chess-{{ ai_gen_id }} {
      padding: {{ block.settings.padding | times: 0.5 }}px;
      margin-top: -{{ block.settings.overlap_distance | times: 0.5 }}px;
    }
  }
{% endstyle %}

<div
  class="ai-floating-chess-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-floating-chess-container-{{ ai_gen_id }}">
    {% if block.settings.chess_image %}
      <img
        src="{{ block.settings.chess_image | image_url: width: 1000 }}"
        alt="{{ block.settings.chess_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.chess_image.width }}"
        height="{{ block.settings.chess_image.height }}"
        class="ai-floating-chess-image-{{ ai_gen_id }}"
      >
    {% else %}
      <div class="ai-floating-chess-placeholder-{{ ai_gen_id }}">
        {{ 'image' | placeholder_svg_tag }}
        <div class="ai-floating-chess-empty-state-{{ ai_gen_id }}">
          Agrega una imagen de una ficha de ajedrez
        </div>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Ficha de ajedrez flotante",
  "settings": [
    {
      "type": "header",
      "content": "Imagen"
    },
    {
      "type": "image_picker",
      "id": "chess_image",
      "label": "Imagen de ficha de ajedrez"
    },
    {
      "type": "range",
      "id": "image_max_width",
      "label": "Ancho máximo de imagen",
      "min": 50,
      "max": 600,
      "step": 50,
      "unit": "px",
      "default": 250
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Ancho en escritorio",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Posición"
    },
    {
      "type": "range",
      "id": "overlap_distance",
      "label": "Superposición sobre encabezado",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Espaciado",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Animación flotante"
    },
    {
      "type": "range",
      "id": "float_distance",
      "label": "Distancia de flotación",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "animation_duration",
      "label": "Duración de animación",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 4
    },
    {
      "type": "range",
      "id": "rotation_start",
      "label": "Rotación inicial",
      "min": -15,
      "max": 15,
      "step": 1,
      "unit": "°",
      "default": -5
    },
    {
      "type": "range",
      "id": "rotation_end",
      "label": "Rotación final",
      "min": -15,
      "max": 15,
      "step": 1,
      "unit": "°",
      "default": 5
    }
  ],
  "presets": [
    {
      "name": "Ficha de ajedrez flotante"
    }
  ]
}
{% endschema %}
